<!DOCTYPE html>
<html>
<head>
    <title><%= job.title %> | HireLens</title>
    <style>
        body { font-family: sans-serif; background: #f8fafc; line-height: 1.6; color: #2c3e50; }
        .container { max-width: 800px; margin: 50px auto; background: white; padding: 40px; border-radius: 12px; shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .meta { color: #64748b; font-size: 0.9rem; margin-bottom: 20px; }
        .description { white-space: pre-wrap; margin: 30px 0; border-top: 1px solid #eee; padding-top: 20px; }
        .apply-now { display: inline-block; background: #3498db; color: white; padding: 15px 30px; text-decoration: none; border-radius: 6px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" style="text-decoration: none; color: #3498db;">← Back to Job Board</a>
        <h1><%= job.title %></h1>
        <div class="meta">
            <span>📍 <%= job.location %></span> | 
            <span>💰 <%= job.salary %></span>
        </div>

        <div class="description">
            <%= job.description %>
        </div>

        <a href="/apply/<%= job._id %>" class="apply-now">Interested? Apply Now</a>
    </div>
</body>
</html>